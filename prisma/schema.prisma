generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  email        String       @unique
  passwordHash String
  avatar       String?
  bio          String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  movies         Movie[]
  videogames     Videogame[]
  books          Book[]
  activities     Activity[]
  moments        Moment[]
  journalEntries JournalEntry[]
  customLists    CustomList[]
}

model Movie {
  id             String    @id @default(uuid())
  userId         String
  title          String
  originalTitle  String?
  year           Int?
  director       String?
  genres         String?
  posterUrl      String?
  watchedDate    DateTime?
  rating         Float?
  status         String    @default("Vista")
  notes          String?
  review         String?
  tags           String?
  isFavorite     Boolean   @default(false)
  markedMe       Boolean   @default(false)
  rewatch        Boolean   @default(false)
  favoriteOrder  Int?
  personalPhotos String?
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moments        Moment[]
  journalEntries JournalEntry[]
}

model Videogame {
  id             String    @id @default(uuid())
  userId         String
  title          String
  platform       String?
  year           Int?
  developer      String?
  genres         String?
  coverUrl       String?
  playedDate     DateTime?
  rating         Float?
  status         String    @default("Terminado")
  notes          String?
  review         String?
  tags           String?
  isFavorite     Boolean   @default(false)
  markedMe       Boolean   @default(false)
  rewatch        Boolean   @default(false)
  favoriteOrder  Int?
  personalPhotos String?
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moments        Moment[]
  journalEntries JournalEntry[]
}

model Book {
  id             String    @id @default(uuid())
  userId         String
  title          String
  author         String?
  year           Int?
  genre          String?
  coverUrl       String?
  readDate       DateTime?
  rating         Float?
  status         String    @default("Leído")
  notes          String?
  review         String?
  tags           String?
  isFavorite     Boolean   @default(false)
  markedMe       Boolean   @default(false)
  rewatch        Boolean   @default(false)
  favoriteOrder  Int?
  personalPhotos String?
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moments        Moment[]
  journalEntries JournalEntry[]
}

model Activity {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  action     String
  title      String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Moment {
  id          String    @id @default(uuid())
  userId      String
  title       String
  content     String
  date        DateTime?
  location    String?
  sharedWith  String?
  imageUrl    String?
  movieId     String?
  videogameId String?
  bookId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie?     @relation(fields: [movieId], references: [id], onDelete: SetNull)
  videogame   Videogame? @relation(fields: [videogameId], references: [id], onDelete: SetNull)
  book        Book?      @relation(fields: [bookId], references: [id], onDelete: SetNull)
}

model JournalEntry {
  id          String    @id @default(uuid())
  userId      String
  title       String
  content     String
  date        DateTime  @default(now())
  images      String?
  movieId     String?
  videogameId String?
  bookId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie?     @relation(fields: [movieId], references: [id], onDelete: SetNull)
  videogame   Videogame? @relation(fields: [videogameId], references: [id], onDelete: SetNull)
  book        Book?      @relation(fields: [bookId], references: [id], onDelete: SetNull)
}

model CustomList {
  id          String           @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?          @default("#f59e0b")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CustomListItem[]
}

model CustomListItem {
  id         String     @id @default(uuid())
  listId     String
  entityType String
  entityId   String
  order      Int        @default(0)
  createdAt  DateTime   @default(now())

  customList CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
}
